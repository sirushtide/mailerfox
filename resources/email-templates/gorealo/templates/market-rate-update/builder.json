            {
              "id": "w-663ba58679",
              "type": "rich_text",
              "name": "Text",
              "props": {
                "html": "<p style=\"font-size:16px;line-height:1.7;color:#374151\">Hi {{first_name}}, when you compare mortgage offers, make sure you’re looking at the same loan amount, program, term, points, and assumptions.</p><p style=\"font-size:16px;line-height:1.7;color:#162849;font-weight:bold\">Have you received more than one quote?</p>",
